IDD_WARNING DIALOG DISCARDABLE  0, 0, 186, 117
STYLE DS_SYSMODAL | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | 
    WS_CAPTION
CAPTION "Computer is shutting down"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDC_DO_IT_NOW,7,96,82,14
    EDITTEXT        IDC_SHUTDOWN_TEXT,7,21,172,56,ES_CENTER | ES_MULTILINE | 
                    ES_AUTOVSCROLL
    CTEXT           "POWEROFF Initiated",IDC_SHUTDOWN_INFO,7,7,172,8
    CTEXT           "Time left: 0 seconds",IDC_SHUTDOWN_TIME,7,79,172,8
    PUSHBUTTON      "Cancel",IDC_CANCEL,97,96,82,14
END

