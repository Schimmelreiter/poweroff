/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_POWEROFF            ICON    DISCARDABLE     "ipoweroff_new.ico"
IDI_POWEROFF_SMALL      ICON    DISCARDABLE     "ipoweroff_small.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_QUICKMENU MENU DISCARDABLE 
BEGIN
    POPUP "Action"
    BEGIN
        MENUITEM "Restore",                     IDC_RESTORE
        MENUITEM SEPARATOR
        MENUITEM "Logoff",                      IDC_LOGOFF
        MENUITEM "Reboot",                      IDC_REBOOT
        MENUITEM "Shutdown",                    IDC_SHUTDOWN
        MENUITEM "Poweroff",                    IDC_POWEROFF
        MENUITEM "Standby",                     IDC_STANDBY
        MENUITEM "Hibernate",                   IDC_Q_HIBERNATE
        MENUITEM "Lock",                        IDC_Q_LOCK
        MENUITEM "Monitor off",                 IDC_Q_MONITOR_OFF
        MENUITEM SEPARATOR
        MENUITEM "Cancel pending action",       IDC_CANCEL
        MENUITEM SEPARATOR
        MENUITEM "Exit",                        IDC_EXIT
    END
END

IDR_POWEROFF MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Save settings",              IDC_SAVE
        MENUITEM "&Load settings",              IDC_LOAD_SETTINGS
        MENUITEM "&Remove settings",            IDC_REMOVE_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "&Exit",                       IDC_CANCEL
    END
    POPUP "&Service"
    BEGIN
        MENUITEM "&Create service",             ID_CREATESERVICE
        MENUITEM "&Remove service",             IDC_REMOVE_SERVICE
        MENUITEM SEPARATOR
        MENUITEM "&Save settings to service",   ID_SAVESETTINGSTOSERVICE
        MENUITEM "&Load settings from service", ID_LOADSETTINGSFROMSERVICE
    END
END

#endif    // Dutch (Belgium) resources
